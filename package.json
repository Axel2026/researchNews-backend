{
  "name": "research-news-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts",
    "db:backfill-field-slug": "tsx src/db/backfill-field-slug.ts",
    "ingest:core": "tsx src/ingest/core.ts",
    "ingest:extra": "tsx src/ingest/upsert-extra.ts",
    "ingest:legacy": "tsx src/ingest/upsert-legacy.ts",
    "ingest:links": "tsx src/ingest/refresh-links.ts",
    "ingest:dates": "tsx src/ingest/refresh-dates.ts",
    "ingest:images": "tsx src/ingest/upload-images.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "5.3.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.2",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  }
}
